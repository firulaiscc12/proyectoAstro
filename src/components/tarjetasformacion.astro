---
import formacion from "../data/formacion.json";
---

<div class="fondo">
    <div class="contenido">
        <img class="personaje" src="/personajes/formacion.png" alt="" />

        <div class="lista">
            {
                formacion.map((estudio) => (
                    <div class="tarjeta">
                        <div class="arriba">
                            <div class="texto">
                                <span class="periodo">{estudio.periodo}</span>
                                <h3>{estudio.centro}</h3>
                                <p>{estudio.texto}</p>
                            </div>
                            <img
                                class="imagen"
                                src={estudio.imagen}
                                alt={estudio.centro}
                            />
                        </div>
                        <div class="abajo">
                            <span>{estudio.estudios}</span>
                            <a class="saber" href="#">
                                Saber más{" "}
                                <img src="/iconos/flecha.png" alt="" />
                            </a>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</div>

<style>
    .fondo {
        background: #1a1f1c;
        padding: 40px 3.5rem 60px 3.5rem;
        font-family: system-ui, sans-serif;
    }

    .contenido {
        display: flex;
        align-items: flex-end;
        gap: 20px;
    }

    .personaje {
        height: 150px;
    }

    .lista {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .tarjeta {
        display: flex;
        flex-direction: column;
        gap: 12px;
        padding: 16px;
        background: #1f2622;
        border: 1px solid #33443a;
        border-radius: 10px;
        color: white;
    }

    .arriba {
        display: flex;
        gap: 20px;
    }

    .texto {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .periodo {
        color: #ffc107;
        font-size: 12px;
    }

    h3 {
        margin: 0;
        font-size: 18px;
    }

    p {
        margin: 0;
        font-size: 12px;
        color: #cccccc;
    }

    .imagen {
        width: 220px;
        height: 120px;
        object-fit: cover;
        border-radius: 8px;
    }

    .abajo {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-top: 1px solid #c9a227;
        padding-top: 10px;
        font-size: 12px;
    }

    .saber {
        display: flex;
        align-items: center;
        gap: 6px;
        color: #ffc107;
        text-decoration: none;
    }

    .saber img {
        width: 14px;
        height: 14px;
    }
</style>
