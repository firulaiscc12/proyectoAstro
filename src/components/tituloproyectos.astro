---
import archivo from "../assets/carpeta.png";
import flecha from "../assets/flecha-correcta.png";
---

<div class="fondo" id="proyectos">
    <div class="titulo">
        <div class="icono"><img src={archivo.src} alt="" /></div>
        <h2>Proyectos <span class="azul">Realizados</span></h2>
        <div class="linea"></div>
        <a class="ver" href="#">
            Ver todos los proyectos <img src={flecha.src} alt="" />
        </a>
    </div>
    <p class="descripcion">
        Algunos de los proyectos en los que he trabajado y aprendido.
    </p>
</div>

<style>
    .fondo {
        background: #1a1f1c;
        padding: 60px 3.5rem 0 3.5rem;
        font-family: system-ui, sans-serif;
    }

    .titulo {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .icono {
        background: #ffb700;
        border-radius: 8px;
        width: 40px;
        height: 40px;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .icono img {
        width: 24px;
        height: 24px;
    }

    h2 {
        margin: 0;
        font-size: 45px;
        color: white;
    }

    .azul {
        color: #00b4ff;
    }

    .linea {
        flex: 1;
        height: 2px;
        background: #1fa88a;
        margin-left: 60px;
    }

    .ver {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #ffc107;
        text-decoration: none;
        font-size: 14px;
    }

    .ver img {
        width: 16px;
        height: 16px;
    }

    .descripcion {
        color: #cccccc;
        font-size: 15px;
        margin: 10px 0 0 0;
    }
</style>
