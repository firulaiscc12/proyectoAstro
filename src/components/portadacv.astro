---
import danicoffe from "../assets/danicoffe.png"
---

<div class="contenedor1">
    <div class="izquierda">
        <h1><span class="dani">Bienvenidos a mi portfolio, soy Dani</span><br> Desarrolador <span class="web">web</span>
            <br><span class="junior">junior</span></h1>
        <button>Conóceme más</button>
    </div>
    <div class="derecha">
        <img src={danicoffe.src} class="danicoffe">
    </div>
</div>

<style>

    .contenedor1 {
       display: flex;
    padding: 0 3.15rem;
    justify-content: space-between;
    align-items: center;
    height: 90vh;
    position: relative;
    background: url(../assets/portada.png);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    }

    .dani{
        font-size: 20px;
        color: white;
        font-weight: lighter;
    }

    .web{
        color: aqua;
    }

    .junior{
        color: yellow;
    }

    h1{
        font-size: 60px;
        color: white;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
    }

    button{
        padding: 10px 30px 10px 30px;
        border-radius: 30px;
        background: yellow;
        border: none;
    }

    
    .danicoffe{
        height: 250px;
        position: absolute;
        bottom: 0px;
        right: 0px;
    }




</style>
