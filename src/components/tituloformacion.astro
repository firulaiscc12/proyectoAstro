---
import formacion from "../assets/educacion.png"

---


<div class="fondo" id="formacion">
    <div class="titulo">
        <div class="icono"><img src={formacion.src} alt="" /></div>
        <h2>Formación <span class="azul">Académica</span></h2>
        <div class="linea"></div>
    </div>
    <p class="descripcion">
        Mi recorrido académico y formación en el área de la tecnología.
    </p>
</div>

<style>
    .fondo {
        background: #1a1f1c;
        padding: 60px 3.5rem 0 3.5rem;
        font-family: system-ui, sans-serif;
    }

    .titulo {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .icono {
        background: #ffc107;
        border-radius: 8px;
        width: 40px;
        height: 40px;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .icono img {
        width: 24px;
        height: 24px;
    }

    h2 {
        margin: 0;
        font-size: 45px;
        color: white;
    }

    .azul {
        color: #00b4ff;
    }

    .linea {
        width: 200px;
        height: 2px;
        background: #1fa88a;
        margin-left: 60px;
    }

    .descripcion {
        color: #cccccc;
        font-size: 15px;
        margin: 10px 0 0 0;
    }
</style>
