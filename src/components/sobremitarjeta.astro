---
import fondosobremi from "../assets/FondoSobremi.png";
import MySQL from "../assets/Mysql.png";
import spain from "../assets/spain.png";
import html from "../assets/html-5.png";
import css from "../assets/CSS.webp";
import java from "../assets/javascript.png";
import mongo from "../assets/mongoDB.png";
import gith from "../assets/githubnegro (1).png";
import ingles from "../assets/Ingles.webp";
---

<div class="tarjeta">
    <img class="foto" src={fondosobremi.src} alt="Sobre mí" />

    <div class="bloque">
        <div class="fila">
            <h4>SKILLS</h4>
            <span class="etiqueta"><img src={html.src} alt="" /> HTML</span>
            <span class="etiqueta"><img src={css.src} alt="" /> CSS</span>
            <span class="etiqueta"
                ><img src={java.src} alt="" /> JavaScript</span
            >
        </div>
        <div class="fila">
            <span class="etiqueta"><img src={MySQL.src} alt="" /> MySQL</span>
            <span class="etiqueta"><img src={mongo.src} alt="" /> MongoDB</span>
            <span class="etiqueta"><img src={gith.src} alt="" /> Git</span>
        </div>
    </div>

    <div class="bloque">
        <h4>IDIOMAS</h4>
        <div class="fila">
            <span class="etiqueta"><img src={spain.src} alt="" /> Español</span>
            <span class="etiqueta"
                ><img src={ingles.src} alt="" /> Inglés</span
            >
        </div>
    </div>
</div>

<style>
    .tarjeta {
        flex: 2;
        display: flex;
        flex-direction: column;
        gap: 30px;
        padding: 50px 30px 90px 30px;
        background: #1f2d27;
        border: 1px solid #2a4a3c;
        border-radius: 60px;
        font-family: system-ui, sans-serif;
    }

    .foto {
        width: 100%;
        height: 700px;
        object-fit: cover;
        box-sizing: border-box;
        border: 3px solid #1fa88a;
        border-radius: 50px;
    }

    .bloque {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .fila {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    h4 {
        margin: 0;
        color: #00b4ff;
        font-size: 17px;
    }

    .etiqueta {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 22px;
        background: #1b2722;
        border: 1px solid #1fa88a;
        border-radius: 30px;
        color: white;
        font-size: 15px;
    }

    .etiqueta img {
        width: 22px;
        height: 22px;
    }
</style>
