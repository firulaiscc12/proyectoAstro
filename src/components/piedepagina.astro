---
import git from "../assets/githubnegro (1).png";
import mensaje from "../assets/Gmailamarillo.png";
import linke from "../assets/linkedin.png";
import logo from "../assets/logooCV.png";
---

<div class="footer">
    <div class="arriba">
        <span class="logo">
            <img src={logo.src} alt="" />
        </span>
        <span class="estado">Disponible para oportunidades</span>
    </div>

    <div class="linea"></div>

    <div class="centro">
        <p>Construyendo ideas, línea a línea.</p>
        <div class="redes">
            <a href="www.linkedin.com/in/daniel-flores-alcocer-783686348">
                <img src={linke.src} alt="LinkedIn" /></a>
            <a href="https://github.com/dani12-Firulais"
                ><img src={git.src} alt="GitHub" /></a
            >
            <a href="mailto:floresalcocerdaniel12@gmail.com"
                ><img src={mensaje.src} alt="Email" /></a
            >
        </div>
    </div>

    <div class="linea"></div>

    <p class="copy">© 2026 Daniel. Todos los derechos reservados.</p>
</div>

<style>
    .footer {
        display: flex;
        flex-direction: column;
        gap: 15px;
        background: #2b2b2b;
        padding: 20px 3.5rem;
        color: white;
        font-family: system-ui, sans-serif;
    }

    .arriba {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .logo {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 18px;
    }

    .logo img {
        height: 60px;
    }

    .estado {
        color: #2ecc71;
        font-size: 11px;
    }

    .linea {
        height: 2px;
        background: #1b6f8a;
    }

    .centro {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
    }

    .centro p {
        margin: 0;
        font-size: 14px;
        font-weight: bold;
    }

    .redes {
        display: flex;
        gap: 20px;
    }

    .redes img {
        width: 24px;
        height: 24px;
    }

    .copy {
        margin: 0;
        color: #999999;
        font-size: 11px;
    }
</style>
