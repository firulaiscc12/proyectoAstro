---
import Logo from "./logo.astro";
import articulo from "../assets/articulo.jpg";
import productos from "../data/productos.json";
---

<div class="tienda">
    <div class="barra">
        <div class="lado"></div>
        <Logo />
        <div class="lado derecha">
            <input type="text" placeholder="BUSCAR" />
        </div>
    </div>

    <div class="fila">
        {
            productos.map((producto) => (
                <div class="producto">
                    <img src={articulo.src} alt={producto.nombre} />
                    <p class="nombre">{producto.nombre}</p>
                    <p class="precio">{producto.precio}</p>
                </div>
            ))
        }
    </div>
</div>

<style>
    .tienda {
        padding: 40px 80px;
    }

    .barra {
        display: flex;
        justify-content: space-between;
        margin-bottom: 50px;
    }

    .lado {
        width: 30px;
        height: 30px;
    }

    .derecha {
        display: flex;
        justify-content: flex-end;
    }

    input {
        width: 250px;
        padding: 10px;
        font-size: 18px;
        font-weight: 600;
        border: 1px solid gray;
        border-radius: 4px;
    }

    .fila {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
    }

    .producto {
        flex: 0 0 calc((100% - 45px) / 4);
        margin-bottom: 45px;
    }

    .producto img {
        width: 100%;
        height: 480px;
        object-fit: cover;
    }

    p {
        margin: 5px 0;
        text-align: center;
        color: #555555;
    }

    .precio {
        font-weight: 600;
    }
</style>
