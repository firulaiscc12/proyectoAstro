---
import logoCV from "../assets/logoCV.png";
---


<div class="barra">
    <div class="logo">
        <a href=""><img src={logoCV.src} alt="" class="logoo"></a>
    </div>
    <div class="opciones">
        <a href="">Inicio</a>
        <a href="">Sobre mi</a>
        <a href="">Experiencia</a>
        <a href="">Proyectos</a>
        <a href="">Contacto</a>
    </div>
</div>

<style>

    .logoo {
        height: 80px;
    }
    .barra {
        height: 70px;
        background: #202226;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 3.5rem;
    }

    .logo a{
        color: white;
        text-decoration: none;
        font-size: 25px;
        
    }

    .opciones{
        display: flex;
        gap: 30px;
    }

    .opciones a {
        color: white;
        text-decoration: none;
    }
</style>
