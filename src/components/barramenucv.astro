---
import logocv from "../assets/logooCV.png";
---

<div class="barra">
    <div class="logo">
        <a href="#inicio"><img src={logocv.src} alt="" class="logoo" /></a>
    </div>
    <div class="opciones">
        <a href="#inicio">Inicio</a>
        <a href="#experiencia">Experiencia</a>
        <a href="#proyectos">Proyectos</a>
        <a href="#formacion">Formación</a>
        <a href="#sobremi">Sobre mí</a>
        <a href="#contacto">Contacto</a>
    </div>
</div>

<style>
    .logoo {
        height: 80px;
    }

    .barra {
        position: sticky; 
        top: 0;
        z-index: 100; 
        height: 70px;
        background: #202226;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 3.5rem;
    }

    .logo a {
        color: white;
        text-decoration: none;
        font-size: 25px;
    }

    .opciones {
        display: flex;
        gap: 30px;
    }

    .opciones a {
        color: white;
        text-decoration: none;
    }

    .opciones a:hover {
        color: #ffb700;
    }
</style>
