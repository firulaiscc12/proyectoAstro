---
import usuario from '../assets/usuario.png';
---


<div class="cabecera">
	<nav>
		<div class="enlaces">
			<a href="/" class="activo">HOME</a>
			<a href="/genero">SHOP</a>
		</div>
		<div class="usuario">
			<a href="/login">User_name</a>
			<img src={usuario.src}  alt="Avatar" width="55" />
		</div>
	</nav>

	<div class="texto">
		<h1>REBAJAS</h1>
		<h2>MIRTO MUJER</h2>
		<p>-10% -20% -30% -40% -50%</p>
	</div>
</div>

<style>
	.cabecera {
		height: 700px;
		background-image: url('/src/assets/cabecera.jpg');
		background-size: cover;
		background-position: center;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		color: white;
	}

	nav {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 30px 60px;
	}

	.enlaces {
		display: flex;
		gap: 40px;
	}

	a {
		color: #444444;
		font-weight: 600;
		font-size: 20px;
		text-decoration: none;
	}

	.activo {
		text-decoration: underline;
	}

	.usuario {
		display: flex;
		align-items: center;
		gap: 20px;
		color: #444444;
		font-size: 20px;
	}

	.usuario img {
		border-radius: 50%;
	}

	.texto {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding-bottom: 30px;
	}

	h1 {
		font-size: 100px;
		font-weight: 700;
		margin: 0;
	}

	h2 {
		font-size: 40px;
		font-weight: 300;
		font-style: italic;
		margin: 10px 0 30px 0;
	}

	p {
		font-size: 55px;
		margin: 0;
	}
</style>