---
import proyectos from "../data/proyectos.json";
import eldenring from "../assets/Eldenring.jpg";
import cineticket from "../assets/cineticket.jpg";
import circulodeflecha from "../assets/circulo-de-flecha.png";
import proyectoestetica from "../assets/proyectoestetica.jpg";
---

<div class="fondo">
    <div class="contenido">
        <div class="fila">
            <div class="tarjeta">
                <img
                    class="imagen"
                    src={cineticket.src}
                    alt={proyectos[0].titulo}
                />
                <h3>{proyectos[0].titulo}</h3>
                <div class="abajo">
                    <p>{proyectos[0].descripcion}</p>
                    <a class="circulo" href={proyectos[0].enlace}>
                        <img src={circulodeflecha.src} alt="" />
                    </a>
                </div>
            </div>

            <div class="tarjeta">
                <img
                    class="imagen"
                    src={proyectoestetica.src}
                    alt={proyectos[1].titulo}
                />
                <h3>{proyectos[1].titulo}</h3>
                <div class="abajo">
                    <p>{proyectos[1].descripcion}</p>
                    <a class="circulo" href={proyectos[1].enlace}>
                        <img src={circulodeflecha.src} alt="" />
                    </a>
                </div>
            </div>

            <div class="tarjeta">
                <img
                    class="imagen"
                    src={eldenring.src}
                    alt={proyectos[2].titulo}
                />
                <h3>{proyectos[2].titulo}</h3>
                <div class="abajo">
                    <p>{proyectos[2].descripcion}</p>
                    <a class="circulo" href={proyectos[2].enlace}>
                        <img src={circulodeflecha.src} alt="" />
                    </a>
                </div>
            </div>
        </div>

        <img class="personaje" src="/personajes/proyectos.png" alt="" />
    </div>
</div>

<style>
    .fondo {
        background: #1a1f1c;
        padding: 40px 3.5rem 60px 3.5rem;
        font-family: system-ui, sans-serif;
    }

    .contenido {
        display: flex;
        align-items: flex-end;
        gap: 20px;
    }

    .fila {
        flex: 1;
        display: flex;
        gap: 20px;
    }

    .tarjeta {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding: 12px;
        background: #1f2622;
        border: 2px solid #2e5c45;
        border-radius: 20px;
        color: white;
    }

    .imagen {
        width: 100%;
        height: 150px;
        object-fit: cover;
        border-radius: 12px;
    }

    h3 {
        margin: 0;
        font-size: 15px;
    }

    .abajo {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .abajo p {
        flex: 1;
        margin: 0;
        font-size: 12px;
        color: #cccccc;
    }

    .circulo {
        width: 50px;
        height: 50px;
        background: #ffb700;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .circulo img {
        height: 50px;
    }

    .personaje {
        height: 180px;
    }
</style>
