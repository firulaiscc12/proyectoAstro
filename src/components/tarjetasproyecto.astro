---
import proyectos from "../data/proyectos.json";
---

<div class="fondo">
    <div class="contenido">
        <div class="fila">
            {
                proyectos.map((proyecto) => (
                    <div class="tarjeta">
                        <img
                            class="imagen"
                            src={proyecto.imagen}
                            alt={proyecto.titulo}
                        />
                        <h3>{proyecto.titulo}</h3>
                        <div class="abajo">
                            <p>{proyecto.descripcion}</p>
                            <a class="circulo" href={proyecto.enlace}>
                                <img src="/iconos/flecha-circulo.png" alt="" />
                            </a>
                        </div>
                    </div>
                ))
            }
        </div>

        <img class="personaje" src="/personajes/proyectos.png" alt="" />
    </div>
</div>

<style>
    .fondo {
        background: #1a1f1c;
        padding: 40px 3.5rem 60px 3.5rem;
        font-family: system-ui, sans-serif;
    }

    .contenido {
        display: flex;
        align-items: flex-end;
        gap: 20px;
    }

    .fila {
        flex: 1;
        display: flex;
        gap: 20px;
    }

    .tarjeta {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding: 12px;
        background: #1f2622;
        border: 2px solid #2e5c45;
        border-radius: 20px;
        color: white;
    }

    .imagen {
        width: 100%;
        height: 150px;
        object-fit: cover;
        border-radius: 12px;
    }

    h3 {
        margin: 0;
        font-size: 15px;
    }

    .abajo {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .abajo p {
        flex: 1;
        margin: 0;
        font-size: 12px;
        color: #cccccc;
    }

    .circulo {
        width: 28px;
        height: 28px;
        border: 2px solid #ffc107;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .circulo img {
        width: 12px;
        height: 12px;
    }

    .personaje {
        height: 180px;
    }
</style>
